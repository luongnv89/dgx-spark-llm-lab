# Environment variables for the benchkit harness
# Source this file or export the variables before running any bench command.
# See AGENTS.md for the full toolchain floor and etiquette.

# --- Endpoint ---
# Base URL of an OpenAI-compatible LLM endpoint (must include /v1)
# Default: http://localhost:8001/v1
BENCH_BASE_URL=http://localhost:8001/v1

# Model id as reported by the endpoint's /v1/models endpoint
BENCH_MODEL=montimage-dgx-spark

# --- Behaviour ---
# Run with thinking enabled (1/true/True) or disabled (0/false/"")
# Default: 0 (disabled)
BENCH_THINKING=0

# Maximum output tokens per generation
# Default: 6000
BENCH_MAX_TOKENS=6000

# Number of samples per task (pass@N evaluation)
# Default: 2
BENCH_SAMPLES=2

# Concurrency: parallel tasks per batch
# Default: 4
BENCH_CONCURRENCY=4

# Timeout in seconds for the test subprocess per sample
# Default: 60
BENCH_TEST_TIMEOUT=60

# --- Harness ---
# Model the harness commands benchmark, as <provider>/<model> or any unique part
# of it, taken from your own opencode / pi configuration.
# List what yours can reach with: bench harness models
# Leave unset to be asked at the start of each run.
BENCH_HARNESS_MODEL=

# OpenAI-compatible endpoint to point a harness at for the run, instead of using
# the providers it already has configured. Opt-in: leave unset to benchmark your
# existing setup. Supported by all three harnesses (opencode, pi, claude-code);
# none of them writes to your own harness configuration to do it.
BENCH_HARNESS_ENDPOINT=

# Path to the pi coding agent directory (used by benchkit/harness/pi.py)
# Leave unset if not using the pi harness
PI_CODING_AGENT_DIR=

# --- Router (optional) ---
# Host and port the router listens on
# Default: 0.0.0.0:8001
# ROUTER_HOST=0.0.0.0
# ROUTER_PORT=8001
